// TOP Procurement — Database Schema
// Source of truth for the schema design: ARCHITECTURE.md §5 + FINAL-INFRASTRUCTURE-ARCHITECTURE.md
// (Attachment.bucket field added there to match the required file-metadata contract).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────
// ENUMS
// ────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  PROCUREMENT_MANAGER
  PROCUREMENT_SPECIALIST
  APPROVER
  EMPLOYEE
  SUPPLIER // reserved for completeness; supplier users have no login in MVP — access is via RFQSupplier.portalToken
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_APPROVAL
  APPROVED
  REJECTED
  RFQ_IN_PROGRESS
  PO_CREATED
  CLOSED
  CANCELLED
}

enum RfqStatus {
  DRAFT
  SENT
  IN_PROGRESS
  CLOSED
  CANCELLED
}

enum RfqSupplierStatus {
  INVITED
  VIEWED
  SUBMITTED
  DECLINED
  EXPIRED
}

enum QuoteStatus {
  SUBMITTED
  NEEDS_REVIEW
  VERIFIED
  REJECTED
}

enum ApprovalEntityType {
  PURCHASE_REQUEST
  PURCHASE_ORDER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  CONFIRMED
  CANCELLED
}

enum AttachmentOwnerType {
  PURCHASE_REQUEST
  QUOTE
  SUPPLIER
  PURCHASE_ORDER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ────────────────────────────────────────────────────────────
// M2.1 — PRODUCT MASTER
// ────────────────────────────────────────────────────────────

enum ProductType {
  GOODS
  MATERIAL
  RAW_MATERIAL
  COMPONENT
  CONSUMABLE
  SERVICE // never stock-tracked — see Product.stockTracked
}

enum ProductTrackingMode {
  QUANTITY // plain on-hand quantity, no lot/piece breakdown (e.g. office goods)
  LOT // tracked as StockLot batches (M2.5+), no individual pieces
  PIECE // tracked as individual StockPiece units within a lot (M2.5+; cuttable materials)
}

// M2.2: how a cross-dimension UomConversion.ratio was obtained. All three are
// distinct real states — NOT_AVAILABLE is not "no row exists", it's an
// explicit "this alt UOM is recognized for the product, no safe coefficient
// yet" marker (substitutes for a separate ProductUom table — see M2.2 Phase A §14).
enum ConversionSource {
  CONFIGURED // manually entered by an admin/manager from known specs
  MEASURED // derived from an actual physical measurement (e.g. a real receipt)
  NOT_AVAILABLE // recognized as a valid alt UOM for this product, but no coefficient confirmed
}

// M2.4-D: AVAILABLE/RESERVED/CONSUMED/SCRAPPED, pre-approved by the original
// M2.4 architecture gate. No transitions implemented in M2.4-D itself — every
// piece created by this slice's CRUD is AVAILABLE (the schema default); the
// other three states are only reachable via a future split/issue/scrap
// operation (StockMovement-era), not built here.
enum StockPieceStatus {
  AVAILABLE
  RESERVED
  CONSUMED
  SCRAPPED
}

// Fixed physical-unit set (M2 PHASE A decision OD-03, confirmed 2026-09-15):
// deliberately an enum, not a UnitOfMeasure table — see
// M2-PRODUCT-STOCK-ARCHITECTURE.md §7-10 for why a nullable-tenant
// UnitOfMeasure table would have been a real hole in the existing
// tenant-isolation DIRECT_TENANT_MODELS mechanism.
enum UomCode {
  PCS
  KG
  G
  TON
  M
  CM
  MM
  M2
  M3
  L
  ML
}

// ────────────────────────────────────────────────────────────
// TENANCY / IDENTITY
// ────────────────────────────────────────────────────────────

model Organization {
  id              String   @id @default(uuid())
  name            String
  legalName       String?
  tin             String?
  defaultCurrency String   @default("UZS")
  timezone        String   @default("Asia/Tashkent")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users            User[]
  departments      Department[]
  categories       Category[]
  suppliers        Supplier[]
  purchaseRequests PurchaseRequest[]
  rfqs             RFQ[]
  purchaseOrders   PurchaseOrder[]
  approvalRules    ApprovalRule[]
  taxRules         TaxRule[]
  exchangeRates    ExchangeRate[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  invitations      Invitation[]
  productCategories ProductCategory[]
  products          Product[]
  uomConversions    UomConversion[]
  warehouses        Warehouse[]
  locations         Location[]
  stockBalances     StockBalance[]
  stockLots         StockLot[]
  stockLotPlacements StockLotPlacement[]
  stockPieces        StockPiece[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String
  passwordHash   String
  fullName       String
  role           UserRole
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id])
  active         Boolean      @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  purchaseRequests PurchaseRequest[] @relation("Requester")
  refreshTokens     RefreshToken[]
  invitationsSent   Invitation[]     @relation("InvitedBy")

  // Global uniqueness (not per-organization): M1 added self-service login by
  // email+password alone, with no organization selector on the login form —
  // the same email cannot belong to two organizations. See top_m1_auth memory
  // / M1 implementation report for the reasoning.
  @@unique([email])
  @@index([organizationId])
  @@map("users")
}

// Opaque refresh tokens are never stored raw — only their SHA-256 hash, so a
// database read alone can't be replayed as a live session. Rotation: every
// /auth/refresh call issues a new token and revokes this one, chaining via
// replacedByTokenId. Reuse of an already-revoked token is treated as evidence
// of token theft and revokes the user's entire active token set (see AuthService).
model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?   @unique
  createdAt         DateTime  @default(now())
  userAgent         String?
  ipAddress         String?

  @@index([userId])
  @@map("refresh_tokens")
}

// Invitation token is stored hashed (same rationale as RefreshToken). Lookup by
// token during accept happens before the invitee has any session/tenant
// context, so it goes through the system (non-tenant-scoped) Prisma client —
// same carve-out as login/register.
model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  email          String
  role           UserRole
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String
  invitedBy      User             @relation("InvitedBy", fields: [invitedById], references: [id])
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())

  @@index([organizationId, status])
  @@map("invitations")
}

// ────────────────────────────────────────────────────────────
// PRODUCT MASTER (M2.1)
// ────────────────────────────────────────────────────────────

model ProductCategory {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  parentId       String?
  parent         ProductCategory? @relation("ProductCategoryTree", fields: [parentId], references: [id])
  children       ProductCategory[] @relation("ProductCategoryTree")
  name           String
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())

  products Product[]

  @@index([organizationId, parentId])
  @@map("product_categories")
}

// Identity = organizationId + sku (see M2-PRODUCT-STOCK-ARCHITECTURE.md OD-01):
// human-readable name never determines uniqueness — "Copper Busbar 50x5" and
// "Медная шина 50х5" with different SKUs are two distinct Product rows by
// design; near-duplicate detection by name/spec similarity is an explicit
// future AI capability (Phase 2/3), not enforced at the DB layer.
model Product {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  sku            String
  name           String
  description    String?
  productType    ProductType
  categoryId     String?
  category       ProductCategory?    @relation(fields: [categoryId], references: [id])
  brand          String?
  manufacturer   String?
  active         Boolean             @default(true)
  baseUomCode    UomCode
  trackingMode   ProductTrackingMode @default(QUANTITY)
  stockTracked   Boolean             @default(true)
  weightNetKg    Decimal?            @db.Decimal(18, 3)
  weightGrossKg  Decimal?            @db.Decimal(18, 3)
  barcode        String?
  createdById    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  uomConversions UomConversion[]
  specification  MaterialSpecification?
  stockBalances  StockBalance[]
  stockLots      StockLot[]
  stockLotPlacements StockLotPlacement[]
  stockPieces    StockPiece[]

  @@unique([organizationId, sku])
  @@index([organizationId, active])
  @@index([organizationId, categoryId])
  @@index([organizationId, productType])
  @@map("products")
}

// M2.3: hybrid typed + JSONB, 1:1 child of Product (no own organizationId —
// same child pattern as PurchaseRequestItem/AIExtraction, reached only via
// an already tenant-checked Product; see M2-PRODUCT-STOCK-ARCHITECTURE.md
// §18). Dimension fields are fixed-unit-by-name (always mm/mm2/kg-per-m3),
// not a {value, uomCode} pair — see material-specifications.ts doc comment
// for why. `attributes` is the escape hatch for anything not common enough
// to be a typed column; displayValue is a server-computed denormalized
// human-readable summary, never client-writable.
model MaterialSpecification {
  id              String   @id @default(uuid())
  productId       String   @unique
  product         Product  @relation(fields: [productId], references: [id])
  material        String?
  grade           String?
  standard        String?
  countryOfOrigin String?
  widthMm         Decimal? @db.Decimal(18, 3)
  thicknessMm     Decimal? @db.Decimal(18, 3)
  lengthMm        Decimal? @db.Decimal(18, 3)
  heightMm        Decimal? @db.Decimal(18, 3)
  outerDiameterMm Decimal? @db.Decimal(18, 3)
  innerDiameterMm Decimal? @db.Decimal(18, 3)
  crossSectionMm2 Decimal? @db.Decimal(18, 3)
  densityKgM3     Decimal? @db.Decimal(18, 3)
  attributes      Json?
  displayValue    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("material_specifications")
}

// M2.2: always anchored at the owning Product's baseUomCode — `ratio` is
// "how many `uomCode` units equal 1 unit of the product's base UOM" (e.g.
// Product.baseUomCode=KG, uomCode=M, ratio=2.5 means "1 kg = 2.5 m"). Never a
// free (fromUomCode, toUomCode) pair: storing a single direction per
// non-base unit avoids a combinatorial pairwise explosion and the risk of
// the two directions drifting out of sync. The reverse direction is always
// computed as division, never stored. Same-dimension conversions (kg<->g,
// m<->cm) never get a row here — they're exact SI math done in code
// (packages/validation's UOM_BASE_FACTORS), not a "confirmed" coefficient;
// a service-layer check rejects same-dimension-as-base uomCode values.
model UomConversion {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  productId      String
  product        Product          @relation(fields: [productId], references: [id])
  uomCode        UomCode
  ratio          Decimal?         @db.Decimal(18, 6)
  source         ConversionSource
  confirmedById  String?
  confirmedAt    DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([productId, uomCode])
  @@index([organizationId, productId])
  @@map("uom_conversions")
  // Manual addition to the generated migration SQL (Prisma has no declarative
  // CHECK syntax in this version): ALTER TABLE uom_conversions ADD CONSTRAINT
  // uom_conversions_ratio_source_consistency CHECK
  //   (("source" = 'NOT_AVAILABLE' AND "ratio" IS NULL) OR
  //    ("source" != 'NOT_AVAILABLE' AND "ratio" > 0));
  // — see M2.2 §11. productId != baseUomCode / dimension checks are cross-table
  // (would need a trigger) and are enforced at the application layer instead.
}

model Department {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String

  users            User[]
  purchaseRequests PurchaseRequest[]

  @@unique([organizationId, name])
  @@map("departments")
}

model Category {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  active         Boolean      @default(true)

  suppliers        SupplierCategory[]
  purchaseRequests PurchaseRequest[]

  @@unique([organizationId, name])
  @@map("categories")
}

// ────────────────────────────────────────────────────────────
// SUPPLIERS
// ────────────────────────────────────────────────────────────

model Supplier {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  companyName    String
  legalName      String?
  tin            String?
  country        String?
  address        String?
  bankName       String?
  mfo            String?
  bankAccount    String?
  rating         Decimal?     @db.Decimal(5, 2)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  categories     SupplierCategory[]
  contacts       SupplierContact[]
  documents      SupplierDocument[]
  rfqSuppliers   RFQSupplier[]
  purchaseOrders PurchaseOrder[]
  stockLots      StockLot[]

  @@index([organizationId])
  @@map("suppliers")
}

model SupplierCategory {
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([supplierId, categoryId])
  @@map("supplier_categories")
}

model SupplierContact {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  fullName   String
  phone      String?
  email      String?
  telegram   String?
  isPrimary  Boolean  @default(false)

  @@map("supplier_contacts")
}

model SupplierDocument {
  id           String     @id @default(uuid())
  supplierId   String
  supplier     Supplier   @relation(fields: [supplierId], references: [id])
  attachmentId String
  attachment   Attachment @relation(fields: [attachmentId], references: [id])
  docType      String
  createdAt    DateTime   @default(now())

  @@map("supplier_documents")
}

// ────────────────────────────────────────────────────────────
// PURCHASE REQUEST
// ────────────────────────────────────────────────────────────

model PurchaseRequest {
  id              String                @id @default(uuid())
  organizationId  String
  organization    Organization          @relation(fields: [organizationId], references: [id])
  requestNumber   String
  requesterId     String
  requester       User                  @relation("Requester", fields: [requesterId], references: [id])
  departmentId    String?
  department      Department?           @relation(fields: [departmentId], references: [id])
  categoryId      String?
  category        Category?             @relation(fields: [categoryId], references: [id])
  status          PurchaseRequestStatus @default(DRAFT)
  estimatedBudget Decimal?              @db.Decimal(18, 2)
  currency        String                @default("UZS")
  priority        String                @default("normal")
  requiredDate    DateTime?
  reason          String?
  aiGenerated     Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  submittedAt     DateTime?

  items            PurchaseRequestItem[]
  comments         PurchaseRequestComment[]
  rfqs             RFQ[]
  approvalInstance ApprovalInstance?
  purchaseOrders   PurchaseOrder[]

  @@unique([organizationId, requestNumber])
  @@index([organizationId, status])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                String          @id @default(uuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  itemName          String
  description       String?
  quantity          Decimal         @db.Decimal(18, 3)
  unit              String
  technicalSpec     Json?
  // Phase 2 extension point (see FINAL-INFRASTRUCTURE-ARCHITECTURE.md "Product Master extensibility"):
  // productId String? — nullable FK to a future Product model, additive migration, no backfill required.

  @@map("purchase_request_items")
}

model PurchaseRequestComment {
  id                String          @id @default(uuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  authorId          String
  body              String
  createdAt         DateTime        @default(now())

  @@map("purchase_request_comments")
}

// ────────────────────────────────────────────────────────────
// RFQ
// ────────────────────────────────────────────────────────────

model RFQ {
  id                String          @id @default(uuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id])
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  rfqNumber         String
  status            RfqStatus       @default(DRAFT)
  deadline          DateTime
  createdById       String
  createdAt         DateTime        @default(now())
  sentAt            DateTime?

  items           RFQItem[]
  suppliers       RFQSupplier[]
  recommendations Recommendation[]

  @@unique([organizationId, rfqNumber])
  @@index([organizationId, status])
  @@map("rfqs")
}

model RFQItem {
  id            String  @id @default(uuid())
  rfqId         String
  rfq           RFQ     @relation(fields: [rfqId], references: [id])
  itemName      String
  description   String?
  quantity      Decimal @db.Decimal(18, 3)
  unit          String
  technicalSpec Json?

  quoteItems QuoteItem[]

  @@map("rfq_items")
}

model RFQSupplier {
  id             String            @id @default(uuid())
  rfqId          String
  rfq            RFQ               @relation(fields: [rfqId], references: [id])
  supplierId     String
  supplier       Supplier          @relation(fields: [supplierId], references: [id])
  portalToken    String            @unique
  tokenExpiresAt DateTime
  status         RfqSupplierStatus @default(INVITED)
  invitedAt      DateTime          @default(now())
  viewedAt       DateTime?

  quote Quote?

  @@unique([rfqId, supplierId])
  @@map("rfq_suppliers")
}

// ────────────────────────────────────────────────────────────
// QUOTE
// ────────────────────────────────────────────────────────────

model Quote {
  id                String      @id @default(uuid())
  rfqSupplierId     String      @unique
  rfqSupplier       RFQSupplier @relation(fields: [rfqSupplierId], references: [id])
  currency          String
  vatRate           Decimal?    @db.Decimal(5, 2)
  vatIncluded       Boolean     @default(false)
  deliveryCost      Decimal     @default(0) @db.Decimal(18, 2)
  deliveryIncluded  Boolean     @default(false)
  leadTimeDays      Int?
  paymentTerms      String?
  warranty          String?
  notes             String?
  status            QuoteStatus @default(SUBMITTED)
  submittedAt       DateTime    @default(now())

  items          QuoteItem[]
  extraction     AIExtraction?
  attachments    Attachment[]
  purchaseOrders PurchaseOrder[]

  @@index([status])
  @@map("quotes")
}

model QuoteItem {
  id        String  @id @default(uuid())
  quoteId   String
  quote     Quote   @relation(fields: [quoteId], references: [id])
  rfqItemId String
  rfqItem   RFQItem @relation(fields: [rfqItemId], references: [id])
  unitPrice Decimal @db.Decimal(18, 4)
  quantity  Decimal @db.Decimal(18, 3)

  @@map("quote_items")
}

model AIExtraction {
  id                 String    @id @default(uuid())
  quoteId            String    @unique
  quote              Quote     @relation(fields: [quoteId], references: [id])
  sourceAttachmentId String
  documentHash       String
  model              String
  rawFields          Json
  confidenceScores   Json
  needsReview        Boolean   @default(false)
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())

  @@index([documentHash])
  @@map("ai_extractions")
}

// ────────────────────────────────────────────────────────────
// RECOMMENDATION (AI, versioned, audit-able)
// ────────────────────────────────────────────────────────────

model Recommendation {
  id                     String    @id @default(uuid())
  rfqId                  String
  rfq                    RFQ       @relation(fields: [rfqId], references: [id])
  version                Int       @default(1)
  recommendedSupplierId  String
  reasons                Json
  estimatedSaving        Decimal?  @db.Decimal(18, 2)
  cheapestSupplierId     String?
  fastestSupplierId      String?
  model                  String
  inputSnapshot          Json
  createdAt              DateTime  @default(now())
  acceptedById           String?
  acceptedAt             DateTime?
  overridden             Boolean   @default(false)

  @@index([rfqId, version])
  @@map("recommendations")
}

// ────────────────────────────────────────────────────────────
// APPROVAL ENGINE
// ────────────────────────────────────────────────────────────

model ApprovalRule {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  entityType     ApprovalEntityType
  minAmount      Decimal            @db.Decimal(18, 2)
  maxAmount      Decimal?           @db.Decimal(18, 2)
  approverRole   UserRole
  stepOrder      Int                @default(1)
  active         Boolean            @default(true)

  @@index([organizationId, entityType, active])
  @@map("approval_rules")
}

model ApprovalInstance {
  id                 String             @id @default(uuid())
  entityType         ApprovalEntityType
  purchaseRequestId  String?            @unique
  purchaseRequest    PurchaseRequest?   @relation(fields: [purchaseRequestId], references: [id])
  purchaseOrderId    String?            @unique
  purchaseOrder      PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  status             ApprovalStatus     @default(PENDING)
  createdAt          DateTime           @default(now())
  completedAt        DateTime?

  steps ApprovalStepInstance[]

  @@map("approval_instances")
}

model ApprovalStepInstance {
  id                  String           @id @default(uuid())
  approvalInstanceId  String
  approvalInstance    ApprovalInstance @relation(fields: [approvalInstanceId], references: [id])
  stepOrder           Int
  approverRole        UserRole
  assignedUserId       String?
  status               ApprovalStatus   @default(PENDING)
  decidedById          String?
  decidedAt            DateTime?
  comment              String?

  @@map("approval_step_instances")
}

// ────────────────────────────────────────────────────────────
// PURCHASE ORDER
// ────────────────────────────────────────────────────────────

model PurchaseOrder {
  id                   String              @id @default(uuid())
  organizationId       String
  organization         Organization        @relation(fields: [organizationId], references: [id])
  poNumber             String
  purchaseRequestId    String
  purchaseRequest      PurchaseRequest     @relation(fields: [purchaseRequestId], references: [id])
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  quoteId              String
  quote                Quote               @relation(fields: [quoteId], references: [id])
  status               PurchaseOrderStatus @default(DRAFT)
  currency             String
  totalAmount          Decimal             @db.Decimal(18, 2)
  paymentTerms         String?
  expectedDeliveryDate DateTime?
  createdById          String
  createdAt            DateTime            @default(now())

  items            PurchaseOrderItem[]
  approvalInstance ApprovalInstance?

  @@unique([organizationId, poNumber])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  itemName        String
  quantity        Decimal       @db.Decimal(18, 3)
  unit            String
  unitPrice       Decimal       @db.Decimal(18, 4)

  @@map("purchase_order_items")
}

// ────────────────────────────────────────────────────────────
// FINANCE CONFIG
// ────────────────────────────────────────────────────────────

model TaxRule {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  taxType        String       @default("VAT")
  rate           Decimal      @db.Decimal(5, 2)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  active         Boolean      @default(true)

  @@map("tax_rules")
}

model ExchangeRate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  fromCurrency   String
  toCurrency     String
  rate           Decimal      @db.Decimal(18, 6)
  effectiveDate  DateTime

  @@unique([organizationId, fromCurrency, toCurrency, effectiveDate])
  @@map("exchange_rates")
}

// ────────────────────────────────────────────────────────────
// CROSS-CUTTING
// ────────────────────────────────────────────────────────────

model Attachment {
  id             String              @id @default(uuid())
  organizationId String
  ownerType      AttachmentOwnerType
  ownerId        String
  bucket         String              @default("top-documents")
  objectKey      String
  fileName       String
  mimeType       String
  sizeBytes      Int
  uploadedById   String
  createdAt      DateTime            @default(now())

  quote             Quote?             @relation(fields: [quoteId], references: [id])
  quoteId            String?
  supplierDocuments SupplierDocument[]

  @@index([organizationId, ownerType, ownerId])
  @@map("attachments")
}

model Notification {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  type           String
  channel        String
  payload        Json
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  action         String
  entityType     String
  entityId       String
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

// M2.4-A/B: Warehouse + Location + StockBalance (StockLot/StockPiece/
// StockMovement are a separate, not-yet-approved slice — see
// M2-PRODUCT-STOCK-ARCHITECTURE.md and the M2.4 architecture gate). Location
// is a flat list under Warehouse, not a self-referencing tree — the M2.4
// approval explicitly asked for the simpler shape over the original Phase A
// sketch ("не создавать сложную WMS hierarchy").
model Warehouse {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  locations          Location[]
  stockBalances      StockBalance[]
  stockLotPlacements StockLotPlacement[]
  stockPieces        StockPiece[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@map("warehouses")
}

model Location {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  warehouseId    String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id])
  code           String
  name           String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  stockBalances      StockBalance[]
  stockLotPlacements StockLotPlacement[]
  stockPieces        StockPiece[]

  @@unique([warehouseId, code])
  @@index([organizationId, warehouseId])
  @@map("locations")
}

// M2.4-B: current aggregated stock state only — no movement/lot/piece logic
// yet (StockLot/StockPiece/StockMovement are separate, not-yet-approved
// slices; their natural keys and the Balance<->Lot<->Piece invariant are
// explicitly open design questions, not decided here). uomCode is always
// forced server-side to equal Product.baseUomCode — never independently
// client-set (see stock-balances.service.ts). Uniqueness on
// (productId, warehouseId, locationId) can't be expressed as a single
// Prisma @@unique because Postgres treats NULL as distinct from itself, so
// a plain composite unique would allow duplicate warehouse-level rows when
// locationId is NULL — two partial unique indexes are added by hand in the
// migration.sql instead (same pattern as UomConversion's CHECK constraint
// in M2.2). onHandQty/reservedQty >= 0 and reservedQty <= onHandQty are
// also hand-added CHECK constraints — Prisma has no declarative syntax for
// either partial indexes or CHECK constraints as of this schema version.
model StockBalance {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  warehouseId    String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id])
  locationId     String?
  location       Location?    @relation(fields: [locationId], references: [id])
  uomCode        UomCode
  onHandQty      Decimal      @default(0) @db.Decimal(18, 3)
  reservedQty    Decimal      @default(0) @db.Decimal(18, 3)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, productId])
  @@index([organizationId, warehouseId])
  @@index([organizationId, locationId])
  @@map("stock_balances")
}

// M2.4-C: two-level lot model (architecture gate, approved). StockLot is
// physical batch IDENTITY only — no quantity, no warehouseId/locationId.
// lotNumber is external provenance metadata (supplier/manufacturer lot
// numbers are not globally unique, and TOP doesn't control them) — it
// deliberately carries NO uniqueness constraint anywhere. StockLotPlacement
// is WHERE part of a lot physically sits — a lot can have multiple
// placements simultaneously (split across locations/warehouses) without
// losing its identity; a future Transfer only ever touches placements, never
// StockLot itself. Used for QUANTITY/LOT tracking modes; PIECE mode will use
// StockPiece instead (a separate, not-yet-implemented slice) since a piece
// already carries its own placement — StockLotPlacement would be redundant
// there. CRITICAL: M2.4-C does NOT synchronize StockBalance with either of
// these tables — there is no StockMovement yet, so StockLot/StockLotPlacement
// CRUD and StockBalance CRUD are independent administrative records. Before
// StockMovement exists, the system does not guarantee automatic real-time
// synchronization between StockLotPlacement and StockBalance.
model StockLot {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  supplierId     String?
  supplier       Supplier?    @relation(fields: [supplierId], references: [id])
  lotNumber      String?
  receivedAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  placements StockLotPlacement[]
  pieces     StockPiece[]

  @@index([organizationId, productId])
  @@index([organizationId, productId, lotNumber])
  @@index([organizationId, supplierId])
  @@map("stock_lots")
}

// productId is denormalized from StockLot.productId (same single-row
// tenant/composition-check convenience already used by StockPiece's design
// in the original M2.4 gate) — always server-derived, never accepted from
// the client (see stock-lot-placements.service.ts). uomCode is always
// forced to equal Product.baseUomCode — same hard rule as StockBalance in
// M2.4-B, never a client-chosen unit, never density/geometry conversion.
// Uniqueness on (stockLotId, warehouseId, locationId) has the same
// Postgres NULL-distinctness problem as StockBalance in M2.4-B — resolved
// with two hand-added partial unique indexes in migration.sql, not a
// declarative Prisma @@unique.
model StockLotPlacement {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  stockLotId     String
  stockLot       StockLot     @relation(fields: [stockLotId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  warehouseId    String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id])
  locationId     String?
  location       Location?    @relation(fields: [locationId], references: [id])
  uomCode        UomCode
  quantity       Decimal      @default(0) @db.Decimal(18, 3)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, stockLotId])
  @@index([organizationId, productId, warehouseId, locationId])
  @@map("stock_lot_placements")
}

// M2.4-D architecture gate (final, approved with changes): a physical
// object — one piece, one row, never mutated once created by THIS slice.
// productId is server-derived from StockLot.productId (same pattern as
// StockLotPlacement) — never a client-settable field. quantity/uomCode are
// the piece's own natural physical measurement, deliberately NOT converted
// to/duplicated in Product.baseUomCode terms here (no density/geometry/
// hardcoded formula, ever — only a future confirmed product-specific
// UomConversion may do that translation, and only when actually needed).
// A missing conversion does NOT block piece creation.
//
// parentPieceId exists as a nullable column so a FUTURE atomic split/issue
// operation has somewhere to write lineage, but M2.4-D's own create
// endpoint never accepts or sets it — creating a child independently of
// that atomic operation would let a remnant exist while its parent stays
// AVAILABLE, silently duplicating physical quantity. Every piece this slice
// creates is a standalone/original piece. No unique constraint: distinct
// pieces may legitimately coexist at the exact same (product, warehouse,
// location) simultaneously — this is not a StockBalance-style aggregate key.
model StockPiece {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  productId      String
  product        Product           @relation(fields: [productId], references: [id])
  lotId          String
  lot            StockLot          @relation(fields: [lotId], references: [id])
  warehouseId    String
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id])
  locationId     String?
  location       Location?         @relation(fields: [locationId], references: [id])
  parentPieceId  String?
  parentPiece    StockPiece?       @relation("PieceLineage", fields: [parentPieceId], references: [id])
  children       StockPiece[]      @relation("PieceLineage")
  quantity       Decimal           @db.Decimal(18, 3)
  uomCode        UomCode
  status         StockPieceStatus  @default(AVAILABLE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId, lotId])
  @@index([organizationId, productId, warehouseId, locationId, status])
  @@index([organizationId, parentPieceId])
  @@map("stock_pieces")
}
