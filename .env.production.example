# Copy to .env.production (gitignored, never committed). Fill in real values —
# generate secrets with: openssl rand -base64 48
#
# Deploy with:
#   docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml up -d --build

NODE_ENV=production

# Must equal the filename you copy this to — see docker-compose.yml `env_file:`.
ENV_FILE_PATH=.env.production

POSTGRES_USER=top
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=top_procurement
DATABASE_URL=postgresql://top:REPLACE_ME@postgres:5432/top_procurement

REDIS_URL=redis://redis:6379

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_BUCKET=top-documents
S3_FORCE_PATH_STYLE=true

JWT_ACCESS_SECRET=REPLACE_ME_MIN_32_CHARS
JWT_REFRESH_SECRET=REPLACE_ME_MIN_32_CHARS
PORTAL_TOKEN_SECRET=REPLACE_ME_MIN_32_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

AI_PRIMARY_PROVIDER=anthropic
ANTHROPIC_API_KEY=REPLACE_ME
OPENAI_API_KEY=

AI_CONFIDENCE_THRESHOLD=0.85

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Open Decision (FINAL-INFRASTRUCTURE-ARCHITECTURE.md p.3/p.4): real domain + DNS provider,
# and whether the external IP is static or needs a DDNS client.
WEB_DOMAIN=app.REPLACE_ME.uz
API_DOMAIN=api.REPLACE_ME.uz
ALLOWED_ORIGINS=https://app.REPLACE_ME.uz

# Open Decision: ACME email for Let's Encrypt.
ACME_EMAIL=REPLACE_ME@REPLACE_ME.uz

API_PORT=4000
WEB_PORT=3000

# Open Decision (p.1): how much RAM is actually installed — resource limits in
# docker-compose.prod.yml assume 16-32GB; revisit if different.
# Open Decision (p.2): offsite backup destination — "local" only until resolved,
# then e.g. BACKUP_TARGETS=local,offsite-s3 (see infrastructure/backup/targets/).
BACKUP_TARGETS=local
TAG=latest
