# Copy to .env for local `docker compose up`. These are dev-only convenience values —
# never reuse them anywhere near staging/production.
#
# NOTE on DATABASE_URL/REDIS_URL/S3_ENDPOINT hostnames: the values below use Docker
# service names (postgres/redis/minio), correct when api/worker/web run AS CONTAINERS
# (`docker compose up`). If you instead run web/api/worker on the host via `pnpm dev`
# (faster iteration loop — see README.md), export these three with `localhost` instead
# before running pnpm dev, since docker-compose.override.yml publishes their ports to
# localhost for exactly this purpose.

NODE_ENV=development

# Self-referential: lets `docker compose --env-file .env ...` (the default) resolve
# docker-compose.yml's `env_file: ${ENV_FILE_PATH:-.env}` to the right file per
# environment — see .env.staging.example / .env.production.example for the pattern.
ENV_FILE_PATH=.env

POSTGRES_USER=top
POSTGRES_PASSWORD=dev-only-password
POSTGRES_DB=top_procurement
DATABASE_URL=postgresql://top:dev-only-password@postgres:5432/top_procurement

REDIS_URL=redis://redis:6379

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=top-minio-dev
S3_SECRET_KEY=dev-only-minio-secret
S3_BUCKET=top-documents
S3_FORCE_PATH_STYLE=true

JWT_ACCESS_SECRET=dev-only-change-me-min-32-characters-long
JWT_REFRESH_SECRET=dev-only-change-me-min-32-characters-long-2
PORTAL_TOKEN_SECRET=dev-only-change-me-min-32-characters-long-3
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

AI_PRIMARY_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_CONFIDENCE_THRESHOLD=0.85

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

WEB_DOMAIN=localhost:3000
API_DOMAIN=localhost:4000
ALLOWED_ORIGINS=http://localhost:3000

API_PORT=4000
WEB_PORT=3000

BACKUP_TARGETS=local
TAG=latest
