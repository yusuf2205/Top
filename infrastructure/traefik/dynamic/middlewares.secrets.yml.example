# Copy this file to middlewares.secrets.yml (gitignored) before first production deploy.
# Generate the hash with: htpasswd -nbB <username> <password>   (the -B flag uses bcrypt)
# If htpasswd isn't installed: `docker run --rm httpd:alpine htpasswd -nbB <user> <pass>`
http:
  middlewares:
    status-basic-auth:
      basicAuth:
        users:
          - "admin:$2y$05$REPLACE_WITH_REAL_BCRYPT_HASH"
