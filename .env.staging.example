# Copy to .env.staging (NEVER .env — keep it distinct so `docker compose --env-file
# .env.staging -f docker-compose.yml -f docker-compose.staging.yml ...` is explicit).
# Fill in real values before first staging deploy — this file only documents shape/defaults.

NODE_ENV=staging

# Must equal the filename you copy this to — see docker-compose.yml `env_file:`.
ENV_FILE_PATH=.env.staging

POSTGRES_USER=top
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=top_procurement
DATABASE_URL=postgresql://top:REPLACE_ME@postgres:5432/top_procurement

REDIS_URL=redis://redis:6379

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_BUCKET=top-documents
S3_FORCE_PATH_STYLE=true

JWT_ACCESS_SECRET=REPLACE_ME_MIN_32_CHARS
JWT_REFRESH_SECRET=REPLACE_ME_MIN_32_CHARS
PORTAL_TOKEN_SECRET=REPLACE_ME_MIN_32_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

AI_PRIMARY_PROVIDER=anthropic
ANTHROPIC_API_KEY=REPLACE_ME
OPENAI_API_KEY=

AI_CONFIDENCE_THRESHOLD=0.85

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Same Cloudflare Tunnel pattern as production (see .env.production.example) — a
# SEPARATE tunnel/token from prod, so staging and prod are independently revocable.
WEB_DOMAIN=staging-app.toppro.uz
API_DOMAIN=staging-api.toppro.uz
ALLOWED_ORIGINS=https://staging-app.toppro.uz

CLOUDFLARE_TUNNEL_TOKEN=REPLACE_ME

API_PORT=4000
WEB_PORT=3000

# Still open: offsite backup destination. "local" only until resolved.
BACKUP_TARGETS=local
TAG=latest
