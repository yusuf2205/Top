{
  "name": "top-procurement",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @top/database exec prisma generate",
    "db:migrate:dev": "pnpm --filter @top/database exec prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @top/database exec prisma migrate deploy",
    "db:studio": "pnpm --filter @top/database exec prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
